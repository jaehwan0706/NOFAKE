# ============================================
# NoFake Project - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
# For SQLite (default, recommended for development):
DB_DIALECT=sqlite
DB_STORAGE_PATH=./database.sqlite

# For MySQL (uncomment if using MySQL):
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=nofake
# DB_PASSWORD=your_password
# DB_NAME=nofake

# ============================================
# Blockchain Configuration
# ============================================
# Ethereum Sepolia RPC URL (required for Web3 functionality)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Smart Contract Address (deploy your contract first)
CONTRACT_ADDRESS=0x...

# Private Key of Contract Owner (for minting transactions)
# Format: 0x... (with leading 0x)
PRIVATE_KEY=0x...
OWNER_PRIVATE_KEY=0x...

# ============================================
# Kakao OAuth Configuration
# ============================================
# Get these from: https://developers.kakao.com
KAKAO_REST_API_KEY=your_kakao_app_key
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# ============================================
# Web3Auth Configuration (Optional)
# ============================================
# If using Web3Auth for authentication:
JWKS_URI=https://...
TOKEN_AUDIENCE=your_audience

# ============================================
# Phone Verification (Octomo Integration)
# ============================================
# Octomo API Configuration (optional):
OCTOMO_API_URL=https://api.octomo.com
OCTOMO_API_KEY=your_octomo_api_key
OCTOMO_WEBHOOK_SECRET=your_webhook_secret
OCTOMO_DEFAULT_RECEIVER=+821055556666
OCTOMO_TTL_SECONDS=300

# ============================================
# Server Configuration
# ============================================
PORT=3002
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
NETWORK_NAME=Ethereum Sepolia
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io/address

# ============================================
# AWS S3 Configuration (Optional)
# ============================================
# For metadata and image storage:
AWS_REGION=ap-northeast-2
BUCKET_NAME=nofake
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# ============================================
# Frontend Configuration
# ============================================
# These values are also needed in front/.env:
VITE_KAKAO_REST_API_KEY=your_kakao_app_key
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
VITE_API_BASE_URL=http://localhost:3002
